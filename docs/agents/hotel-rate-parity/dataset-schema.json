          "check_in",
          "check_out",
          "currency",
          "n_sources",
          "min_source",
          "min_price",
          "max_source",
          "max_price",
          "spread_pct",
          "median_price",
          "official_source",
          "official_price",
          "official_is_cheapest",
          "undercut_by",
          "undercut_pct",
          "hotel_url"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
