      "transformation": {
        "fields": [
          "location_id",
          "location_name",
          "location_type",
          "language",
          "rating",
          "review_count",
          "rating_counts",
          "reviews_by_language",
          "sub_ratings",
          "ranking",
          "cuisines",
          "price_range",
          "dish_tags",
          "city",
          "country_code",
