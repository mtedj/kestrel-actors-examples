{
  "actor": "kestrel/pdf-to-excel-tables",
  "input": {
    "documentUrls": [
      "https://raw.githubusercontent.com/jsvine/pdfplumber/stable/examples/pdfs/background-checks.pdf"
    ],
    "startPage": 1,
    "maxPagesPerDocument": 3,
    "tableStrategy": "lines",
    "maxResults": 3
  },
  "callOptions": {
    "maxTotalChargeUsd": 0.25,
    "timeout": 300
  },
  "waitSecs": 30
}
