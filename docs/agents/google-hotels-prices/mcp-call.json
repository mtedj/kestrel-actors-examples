{
  "actor": "kestrel/google-hotels-prices",
  "input": {
    "queries": [
      "hotels in Lisbon"
    ],
    "checkIn": "30 days",
    "checkOut": "32 days",
    "adults": 2,
    "currency": "USD",
    "maxHotels": 3,
    "includeOffers": true,
    "offerLevel": "sources",
    "maxOffersPerHotel": 3
  },
  "callOptions": {
    "maxTotalChargeUsd": 0.25,
    "timeout": 300
  },
  "waitSecs": 30
}
